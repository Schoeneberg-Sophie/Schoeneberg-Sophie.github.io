<script> const terminalInput = document.getElementById( 'terminal-input' ); const terminalOutput = document.querySelector( '.terminal-output' );
 if (terminalInput) { terminalInput.addEventListener( 'keydown', function(e) { if (e.key !== 'Enter') { return; } const rawCommand = terminalInput.value.trim(); const cmd = rawCommand.toLowerCase(); const
  commandLine = `<br> <span class="prompt"> PS C:\\Portfolio&gt; </span> ${escapeHtml(rawCommand)}`; let response = ''; 
  
  /* ========================== HOME ========================== */
   if ( cmd === 'home' || cmd === 'index' || cmd === 'index.html' ) 
   { response = '<br>Opening index.html...'; terminalOutput.innerHTML += commandLine + response; terminalInput.value = ''; 
   
   setTimeout( () => { window.location.href = '../index.html'; }, 400 ); return; } 
   
   
   /* ========================== RESUME ========================== */ else if ( cmd === 'resume' || cmd === 'resume.html' ) 
   
{ response = '<br>Opening resume.html...'; terminalOutput.innerHTML += commandLine + response; terminalInput.value = ''; 
setTimeout( () => { window.location.href = '../resume.html'; }, 400 ); return; } 
/* ========================== HELP ========================== */ else if ( cmd === 'help' ) 
{ response = ` <br> Available commands:<br> &nbsp;&nbsp;home&nbsp;&nbsp;&nbsp;&nbsp; 
    Return to home page<br> &nbsp;&nbsp;resume&nbsp;&nbsp; Open resume page<br> &nbsp;&nbsp;clear&nbsp;&nbsp;&nbsp; Clear terminal<br> `; } 
    
    
    /* ========================== CLEAR ========================== */ 
    else if ( cmd === 'clear' || cmd === 'cls' ) 
    { terminalOutput.innerHTML = ` Portfolio Terminal<br><br> Current page: <span class="command-highlight"> 
        aboutme </span> <br><br> Available commands: <span class="command-list"> home&nbsp;&nbsp; resume 
            </span> <br> Type <span class="command-highlight"> help </span> for more options.<br><br> `;
             terminalInput.value = ''; return; } 

/* ========================== EMPTY COMMAND ========================== */ 
else if ( cmd === '' ) { response = ''; }

/* ========================== UNKNOWN COMMAND ========================== */ 
else { response = ` <br> '${escapeHtml(rawCommand)}' is not recognized. Type 'help' to see available commands. `; } 
terminalOutput.innerHTML += commandLine + response + '<br>'; terminalInput.value = ''; /* * Keep the terminal focused * after every command. 

*/ terminalInput.focus(); } ); } /* ================================= HTML ESCAPE FUNCTION ================================= */
function escapeHtml(text) { return text .replace( /&/g, "&amp;" ) .replace( /</g, "&lt;" ) .replace( />/g, "&gt;" ) 
.replace( /"/g, "&quot;" ) .replace( /'/g, "&#039;" ); } </script> </body> </html> 